{
  "name": "@t3code/sentry-plugin",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "mcp": "bun src/mcp.ts",
    "inspect": "bunx @modelcontextprotocol/inspector@2.13.0 -e SENTRY_URL=${SENTRY_URL:-https://sentry.io} -e SENTRY_ORG=${SENTRY_ORG:-} -e SENTRY_AUTH_TOKEN=${SENTRY_AUTH_TOKEN:-} -- bun src/mcp.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "bin": {
    "sentry-t3-plugin-mcp": "src/mcp.ts"
  }
}
